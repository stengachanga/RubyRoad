#!/usr/bin/env bash
# Hackathon demo: generate NovaPay Space Payments service artifacts.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

export GEM_HOME="${GEM_HOME:-$root/vendor/bundle}"
export BUNDLE_PATH="${BUNDLE_PATH:-$root/vendor/bundle}"

echo "==> bundle install"
bundle install

echo "==> ./integrate --spec examples/provider_api.yaml --provider novapay --lang ruby"
./integrate --spec examples/provider_api.yaml --provider novapay --lang ruby

echo "==> output/"
ls -l output/novapay_service.rb output/INTEGRATION.md output/fixtures.json
