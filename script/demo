#!/usr/bin/env bash
# Демо хакатона: сгенерировать артефакты NovaPay.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

echo "==> bundle install"
bundle install

echo "==> ./integrate --spec examples/provider_api.yaml --provider novapay --lang ruby"
./integrate --spec examples/provider_api.yaml --provider novapay --lang ruby

echo "==> output/"
ls -l output/novapay_service.rb output/INTEGRATION.md output/fixtures.json
