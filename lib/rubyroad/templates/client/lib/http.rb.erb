# frozen_string_literal: true

<%= header_comment %>

require "faraday"
require "json"
require "uri"

module <%= module_name %>
  class Http
    def initialize(config)
      @config = config
    end

    def perform(method, path, body: nil, headers: {}, query: {})
      response = connection.public_send(method, join(path)) do |req|
        Auth.headers(@config).each { |key, value| req.headers[key] = value }
        headers.each { |key, value| req.headers[key] = value }
        req.params.update(stringify_keys(query)) if query && !query.empty?
        req.body = body unless body.nil?
      end
      raise_for!(response)
      response.body
    rescue Faraday::ConnectionFailed, Faraday::TimeoutError, Faraday::SSLError => e
      raise APIConnectionError, "Could not reach #{@config.base_url}: #{e.message}"
    end

    private

    def connection
      origin, = split_base
      Faraday.new(url: origin) do |faraday|
        faraday.request :json
        faraday.response :json, content_type: /\bjson$/
        faraday.options.timeout = @config.timeout
        faraday.options.open_timeout = @config.open_timeout
        faraday.response :logger, @config.logger, { headers: false, bodies: false } if @config.logger
        faraday.adapter Faraday.default_adapter
      end
    end

    def join(path)
      _, prefix = split_base
      "#{prefix}#{path.start_with?('/') ? path : "/#{path}"}"
    end

    def split_base
      uri = URI.parse(@config.base_url)
      origin = "#{uri.scheme}://#{uri.host}"
      origin += ":#{uri.port}" if uri.port && ![80, 443].include?(uri.port)
      prefix = uri.path.to_s.sub(%r{/\z}, "")
      [origin, prefix]
    end

    def stringify_keys(hash)
      hash.each_with_object({}) { |(k, v), acc| acc[k.to_s] = v }
    end

    def raise_for!(response)
      return if response.success?

      payload = response.body
      err = extract_error(payload)
      message = err[:message] || response.reason_phrase || "HTTP #{response.status}"
      klass = error_class(response.status, err[:type], err[:code])
      raise klass.new(message, status: response.status, body: payload, code: err[:code])
    end

    def extract_error(payload)
      return {} unless payload.is_a?(Hash)

      node = payload["error"] || payload[:error] || payload
      node = {} unless node.is_a?(Hash)
      {
        type: node["type"] || node[:type],
        code: node["code"] || node[:code],
        message: node["message"] || node[:message]
      }
    end

    def error_class(status, type, code)
      hint = "#{type} #{code}"
      return AuthenticationError if status == 401 || hint.match?(/auth/i)
      return PaymentError if status == 402 || hint.match?(/card|declin|insufficient/i)
      return NotFoundError if status == 404
      return RateLimitError if status == 429
      return InvalidRequestError if status == 400 || status == 409 || status == 422

      APIError
    end
  end
end
