# frozen_string_literal: true

<%= header_comment %>

require_relative "<%= gem_name %>/version"
require_relative "<%= gem_name %>/errors"
require_relative "<%= gem_name %>/money"
require_relative "<%= gem_name %>/models"
require_relative "<%= gem_name %>/config"
require_relative "<%= gem_name %>/auth"
require_relative "<%= gem_name %>/http"
require_relative "<%= gem_name %>/webhooks"
require_relative "<%= gem_name %>/client"

# Generated Faraday client for <%= a.title %>.
module <%= module_name %>
  class << self
    def configure
      yield config
      config
    end

    def config
      @config ||= Config.new
    end

    def reset_config!
      @config = Config.new
    end
  end
end
