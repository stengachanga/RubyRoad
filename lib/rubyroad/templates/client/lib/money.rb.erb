# frozen_string_literal: true

<%= header_comment %>

module <%= module_name %>
  # Integer minor units + ISO currency. Floats are rejected on purpose —
  # binary floating point must never represent payment amounts.
  class Money
    attr_reader :cents, :currency

    def initialize(cents:, currency:)
      if cents.is_a?(Float) || currency.is_a?(Float)
        raise ArgumentError, "Money amounts must be Integer minor units — never Float"
      end

      @cents = Integer(cents)
      @currency = currency.to_s.upcase
      raise ArgumentError, "currency must be a 3-letter ISO code" unless @currency.match?(/\A[A-Z]{3}\z/)
    end

    def to_h
      { amount: cents, currency: currency }
    end

    def ==(other)
      other.is_a?(Money) && other.cents == cents && other.currency == currency
    end

    def to_s
      "#{cents} #{currency}"
    end
  end
end
