# frozen_string_literal: true

RSpec.describe <%= module_name %>::Money do
  it "stores integer minor units and an ISO currency" do
    money = described_class.new(cents: 2500, currency: "usd")
    expect(money.cents).to eq(2500)
    expect(money.currency).to eq("USD")
    expect(money.to_h).to eq(amount: 2500, currency: "USD")
  end

  it "rejects Float amounts" do
    expect { described_class.new(cents: 19.99, currency: "USD") }.to raise_error(ArgumentError, /never Float/)
  end

  it "rejects a non-ISO currency" do
    expect { described_class.new(cents: 100, currency: "US") }.to raise_error(ArgumentError, /ISO/)
  end
end
