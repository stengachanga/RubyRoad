# frozen_string_literal: true

require "bundler/setup"
require <%= gem_name.inspect %>
require "json"
require "stringio"
require "webmock/rspec"
require "openssl"

WebMock.disable_net_connect!

module FixtureHelper
  def fixture(name)
    path = File.expand_path("fixtures/#{name}.json", __dir__)
    raise "missing fixture #{path}" unless File.file?(path)

    JSON.parse(File.read(path))
  end

  def json_headers
    { "Content-Type" => "application/json" }
  end

  def sign_webhook(payload, secret:, timestamp: Time.now.to_i)
    digest = OpenSSL::HMAC.hexdigest("SHA256", secret, "#{timestamp}.#{payload}")
    "t=#{timestamp},v1=#{digest}"
  end
end

RSpec.configure do |config|
  config.include FixtureHelper
  config.expect_with :rspec do |c|
    c.syntax = :expect
  end
  config.mock_with :rspec do |mocks|
    mocks.verify_partial_doubles = true
  end
  config.shared_context_metadata_behavior = :apply_to_host_groups
  config.order = :defined

  config.before do
    <%= module_name %>.reset_config!
    <%= module_name %>.configure do |c|
      c.api_key = "sk_test_acme_123"
      c.secret = "sec_test_456"
      c.webhook_secret = "whsec_test_secret"
      c.environment = :sandbox
    end
  end
end
