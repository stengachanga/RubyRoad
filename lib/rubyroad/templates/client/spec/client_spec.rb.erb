# frozen_string_literal: true

RSpec.describe <%= module_name %>::Client do
  subject(:client) { described_class.new }

  it "uses the sandbox base URL by default" do
    expect(<%= module_name %>.config.base_url).to eq(<%= a.sandbox_url.inspect %>)
    expect(<%= module_name %>.config.sandbox?).to be true
  end

  it "switches to the live URL when environment is :live" do
    <%= module_name %>.config.environment = :live
    expect(<%= module_name %>.config.base_url).to eq(<%= a.live_url.inspect %>)
    expect(<%= module_name %>.config.live?).to be true
  end

  it "sends <%= a.auth_kind == :api_key ? a.auth_header : 'Bearer' %> credentials inferred from the spec" do
    stub = stub_request(:get, %r{<%= a.sandbox_prefix %>})
      .to_return(status: 200, body: "{}", headers: json_headers)

    http = <%= module_name %>::Http.new(<%= module_name %>.config)
    begin
      http.perform(:get, <%= (a.operations.first&.path || "/").inspect %>)
    rescue <%= module_name %>::APIError
      # Some operations require path params; we only care that auth headers were sent.
    end

    expect(stub).to have_been_requested
<% if a.auth_kind == :api_key -%>
    expect(stub).to have_been_requested.with(headers: { <%= a.auth_header.inspect %> => "sk_test_acme_123" })
<% elsif a.auth_kind == :basic -%>
    expect(WebMock).to have_requested(:get, %r{<%= a.sandbox_prefix %>}).with { |req|
      req.headers["Authorization"]&.start_with?("Basic ")
    }
<% else -%>
    expect(WebMock).to have_requested(:get, %r{<%= a.sandbox_prefix %>}).with(headers: { "Authorization" => "Bearer sk_test_acme_123" })
<% end -%>
  end

  it "raises AuthenticationError on HTTP 401" do
    stub_request(:any, /./)
      .to_return(status: 401, body: { error: { type: "authentication_error", message: "bad key" } }.to_json, headers: json_headers)

    expect do
      <%= module_name %>::Http.new(<%= module_name %>.config).perform(:get, "/unauthorized")
    end.to raise_error(<%= module_name %>::AuthenticationError, /bad key/)
  end
end
