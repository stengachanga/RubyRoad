# frozen_string_literal: true

require_relative "lib/<%= gem_name %>/version"

Gem::Specification.new do |spec|
  spec.name = <%= gem_name.inspect %>
  spec.version = <%= module_name %>::VERSION
  spec.authors = ["Generated by RubyRoad"]
  spec.summary = <%= "#{a.title} Ruby client (generated by RubyRoad)".inspect %>
  spec.description = <%= "Faraday client, models, and webhook verifier generated from the #{a.title} OpenAPI spec.".inspect %>
  spec.license = "MIT"
  spec.required_ruby_version = ">= 3.2.0"

  spec.files = Dir["lib/**/*", "README.md", "LICENSE", "docs/**/*"]
  spec.require_paths = ["lib"]

  spec.add_dependency "faraday", "~> 2.9"

  spec.add_development_dependency "rake", "~> 13.0"
  spec.add_development_dependency "rspec", "~> 3.13"
  spec.add_development_dependency "webmock", "~> 3.23"
end
